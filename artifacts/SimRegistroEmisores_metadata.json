		"devdoc": {
			"details": "SIMPLIFICACIONES (el módulo real NO puede tenerlas):         - No hay multifirma: cualquiera puede autorizar o revocar.         - Solo recuerda el ÚLTIMO periodo de cada (emisor, facultad).         - fijarPeriodo() permite fabricar periodos pasados para las pruebas.",
			"kind": "dev",
			"methods": {
				"autorizarEmisor(address,bytes32)": {
					"details": "Debe revertir si el emisor ya está autorizado en esa facultad."
				},
				"estabaAutorizado(address,bytes32,uint256)": {
					"details": "Un periodo de autorización es el intervalo [desde, hasta):      incluye `desde` y excluye `hasta`. Un periodo abierto tiene hasta = 0."
				},
				"revocarEmisor(address,bytes32)": {
					"details": "Debe revertir si el emisor no está autorizado en esa facultad."
				}
			},
			"title": "SimRegistroEmisores — Simulacro del Módulo A",
			"version": 1
		},
		"userdoc": {
			"events": {
				"EmisorAutorizado(address,bytes32,uint256)": {
					"notice": "Se emite cuando la administración autoriza a un emisor en una facultad."
				},
				"EmisorRevocado(address,bytes32,uint256)": {
					"notice": "Se emite cuando la administración retira la autorización."
				}
			},
			"kind": "user",
			"methods": {
				"autorizarEmisor(address,bytes32)": {
					"notice": "Autoriza a `emisor` en `facultad`. Solo la administración (multifirma)."
				},
				"estaAutorizado(address,bytes32)": {
					"notice": "¿Está autorizado AHORA `emisor` en `facultad`?"
				},
				"estabaAutorizado(address,bytes32,uint256)": {
					"notice": "¿Estaba autorizado `emisor` en `facultad` en el instante `momento`         (marca de tiempo Unix, en segundos)?"
				},
				"fijarPeriodo(address,bytes32,uint256,uint256)": {
					"notice": "SOLO PARA PRUEBAS: fija directamente un periodo [desde, hasta)."
				},
				"revocarEmisor(address,bytes32)": {
					"notice": "Retira la autorización de `emisor` en `facultad`. Solo la administración."
				}
			},
			"notice": "Lo usan los Cursos B y C mientras el Curso A desarrolla el real.",
			"version": 1
		}
